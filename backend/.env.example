ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=medinotes

# Clerk issuer must exactly match the JWT iss claim (for example https://example.clerk.accounts.dev)
CLERK_ISSUER=
CLERK_AUDIENCE=
DEV_AUTH_BYPASS=false
DEV_USER_ID=dev_user

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_UPLOAD_BYTES=20971520
MAX_NOTE_CHARS=250000
SUMMARY_CHUNK_CHARS=24000
RATE_LIMIT=60/minute
ADMIN_USER_IDS=

# local or s3. S3 settings also support Cloudflare R2 via S3_ENDPOINT_URL.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
