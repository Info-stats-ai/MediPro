# Required authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required data and AI services
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=medinotes
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional development-only API override. Production always uses same-origin /api routes.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Limits
MAX_UPLOAD_BYTES=15728640
MAX_NOTE_CHARS=250000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional OCR provider for scanned PDFs. It must accept JSON containing
# document_base64 and return JSON shaped as {"text":"..."}.
OCR_WEBHOOK_URL=
OCR_WEBHOOK_TOKEN=

# Optional S3-compatible storage (AWS S3, Cloudflare R2, etc.). If S3_BUCKET is
# blank, extracted text is stored in MongoDB but the raw PDF is not retained.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional comma-separated Clerk user IDs for future admin-only routes.
ADMIN_USER_IDS=

# Optional Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
