# Public Clerk key; when omitted, the app runs in preview mode without auth UI.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# FastAPI base URL. Browser requests always include a Clerk bearer token when configured.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
